---
/** Simple line icons (24 × 24, stroke = currentColor). Decorative unless a `label` is given. */
import { PATHS, type IconName } from "./icons";

interface Props {
  name: IconName;
  label?: string;
  class?: string;
  size?: number;
}


const { name, label, class: className, size = 24 } = Astro.props;
const body = PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={body}
/>
