---
/** The "Thread M" app mark (docs/store-assets/<app>/source/icon.svg), drawn inline. */
import type { AppKey } from "../config/site";

interface Props {
  app?: AppKey;
  class?: string;
  size?: number;
}

const { app = "customer", class: className, size = 36 } = Astro.props;
const bg = { customer: "#6D2E8C", store: "#2E6B4F", courier: "#C2412D" }[app];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="100" height="100" rx="24" fill={bg}></rect>
  <g transform="translate(17.9 15.2) scale(0.6)">
    <path
      d="M20 82 L20 36 C20 21 36 18 43 30 L50 43 L57 30 C64 18 80 21 80 36 L80 62"
      fill="none"
      stroke="#F6F3EE"
      stroke-width="10"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    {app === "customer" && <circle cx="80" cy="85" r="12.5" fill="#F2C14E" />}
    {app === "store" && <rect x="68.5" y="73.5" width="23" height="23" rx="5.5" fill="#F2C14E" />}
    {
      app === "courier" && (
        <path
          d="M92.50 71.50 L65.50 82.80 L75.76 88.24 L79.72 98.50 Z"
          fill="#F2C14E"
          stroke="#F2C14E"
          stroke-width="2.6"
          stroke-linejoin="round"
        />
      )
    }
  </g>
</svg>
