# Malvoya Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/malvoya?schema=public"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Required, at least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Stripe (use sk_test_ keys outside production). The webhook endpoint is
# POST /api/v1/payments/webhook listening for payment_intent.succeeded and payment_intent.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign-in providers
GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=

# Email (verification codes, order confirmations). Without SMTP, production sends nothing
# and development only logs the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Malvoya <no-reply@malvoya.com>"
SUPPORT_EMAIL=support@malvoya.com

# SMS (verification codes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated browser origins allowed by CORS (admin panel). "*" is refused in production.
ALLOWED_ORIGINS=http://localhost:5173

# Public address of this API (share links /d/:id, Stripe onboarding return pages, media webhooks)
PUBLIC_API_URL=https://malvoya-api-n065.onrender.com

# Photos and videos (Cloudinary). Without these, uploads are switched off and the apps say so.
# Dashboard → Settings → API Keys. The secret never leaves the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications: Firebase service-account key (raw JSON or base64 of it).
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Share of the delivery fee paid to the courier (1 = the whole fee)
COURIER_FEE_SHARE=1

# Set to "true" to stop background jobs (payouts, video processing checks, clean-ups) on this instance
DISABLE_SCHEDULER=
