# Malvoya Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/malvoya?schema=public"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Required, at least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: key for the 10-minute signed links to store statements. Empty = derived from JWT_SECRET
# (HMAC with its own label), which is fine; set it only to rotate statement links separately.
STATEMENT_LINK_SECRET=

# Stripe (use sk_test_ keys outside production). The webhook endpoint is
# POST /api/v1/payments/webhook listening for payment_intent.succeeded and payment_intent.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign-in providers
GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=

# Email (verification codes, order confirmations). Without SMTP, production sends nothing
# and development only logs the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Malvoya <no-reply@malvoya.com>"
SUPPORT_EMAIL=support@malvoya.com

# SMS (verification codes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Comma-separated browser origins allowed by CORS (admin panel). "*" is refused in production.
ALLOWED_ORIGINS=http://localhost:5173

# Public address of this API (share links /d/:id, /s/:storeId, /r/:code, Stripe onboarding return pages, media webhooks)
PUBLIC_API_URL=https://malvoya-api-eu.onrender.com

# Photos and videos (Cloudinary). Without these, uploads are switched off and the apps say so.
# Dashboard → Settings → API Keys. The secret never leaves the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications: Firebase service-account key (raw JSON or base64 of it). Also used to delete the
# Firebase sign-in user when someone deletes their Malvoya account.
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Courier pay per job, separate from the customer delivery fee (shown to couriers before they accept).
# "formula" (default): base + per km of the shop->customer route (straight line x road factor, 0.1 km),
# at least the minimum; + the ride to the shop beyond the free km; + waiting at the shop after the free
# minutes (capped); + 100 % of tips. "fee_share" = the old rule: COURIER_FEE_SHARE x delivery fee + tip.
COURIER_PAY_MODE=formula
COURIER_PAY_BASE_CENTS=450
COURIER_PAY_PER_KM_CENTS=110
COURIER_PAY_MIN_CENTS=650
COURIER_ROAD_FACTOR=1.3
COURIER_APPROACH_FREE_KM=2
COURIER_APPROACH_PER_KM_CENTS=50
# Couriers further than this from the shop (straight line, fresh position) cannot accept; the paid ride is capped at it
COURIER_APPROACH_MAX_KM=7.5
COURIER_WAIT_FREE_MINUTES=5
COURIER_WAIT_PER_MIN_CENTS=20
COURIER_WAIT_MAX_CENTS=400
COURIER_FEE_SHARE=1

# Customer delivery fee by straight-line distance: the base fee covers the first DELIVERY_FEE_BASE_KM,
# then per km, capped (max 0 = no cap). These defaults are the pre-2.7 prices.
DELIVERY_FEE_BASE_CENTS=190
DELIVERY_FEE_BASE_KM=1.5
DELIVERY_FEE_PER_KM_CENTS=50
DELIVERY_FEE_MAX_CENTS=690

# TEST ONLY (e2e suite): "host:port" list the catalogue import may fetch over plain http.
# Ignored when NODE_ENV=production. Never set it on Render.
# IMPORT_ALLOW_HOSTS=

# Platform fees, all off (0) by default. Shown to the customer in the quote before payment.
# Service fee: percent of the item subtotal, clamped to min/max cents (max 0 = no cap)
SERVICE_FEE_PERCENT=0
SERVICE_FEE_MIN_CENTS=0
SERVICE_FEE_MAX_CENTS=0
# Small-order fee: charged when the item subtotal is below the threshold (threshold 0 = off)
SMALL_ORDER_THRESHOLD_CENTS=0
SMALL_ORDER_FEE_CENTS=0

# Reserve & collect: hours after "ready for pickup" until the customer is reminded, and until an order nobody
# collected is cancelled with a full refund
PICKUP_REMINDER_HOURS=24
PICKUP_HOLD_HOURS=72
# Accepted pickup orders the store never marks ready are refunded after this many hours
PICKUP_READY_HOURS=24

# Invite a friend: discount on a new customer's first order (0 = referrals off) and the one-time code the
# referrer gets once that order is delivered or collected (0 = no reward). Both are paid by Malvoya.
REFERRAL_DISCOUNT_CENTS=0
REFERRAL_REWARD_CENTS=0

# Android App Links for the customer app: SHA-256 fingerprints of its signing certificates (comma-separated,
# AA:BB:...; Play Console → App integrity → App signing). Published at /.well-known/assetlinks.json. Empty = none.
ANDROID_APP_SHA256=

# Scheduled delivery: platform slots in Finnish time (comma-separated HH:MM-HH:MM, not past midnight), bookable
# today or tomorrow from 60 minutes ahead while the store is open at the slot start; couriers are offered the job
# from slot start − the store's prep time − 15 min. The discount comes off the delivery fee (never below 0) and is
# paid by Malvoya (courier pay unchanged). 0 = no discount.
DELIVERY_SLOTS=17:00-19:00,19:00-21:00
SCHEDULED_DELIVERY_DISCOUNT_CENTS=0

# Encryption at rest for sellers' tax identification numbers (DAC7): 32 random bytes, base64
# (openssl rand -base64 32). Without it tax IDs cannot be saved (503) and System says so. Keep a copy somewhere
# safe: losing or changing it makes saved tax IDs unreadable.
DATA_ENCRYPTION_KEY=

# Set to "true" to stop background jobs (payouts, video processing checks, clean-ups) on this instance
DISABLE_SCHEDULER=
