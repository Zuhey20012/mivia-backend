generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // connection URL: see prisma.config.ts (Prisma 7)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  COURIER
  ADMIN
}

enum StoreCategory {
  APPAREL
  COSMETICS
  THRIFT
  ACCESSORIES
  HOME_DECOR
  HANDMADE
  ECO_FRIENDLY
  OTHER
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RentalStatus {
  PENDING
  CONFIRMED
  ACTIVE
  OVERDUE
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  REJECTED
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED_ON_ARRIVAL
  NOT_AS_DESCRIBED
  CHANGED_MIND
  RENTAL_RETURN
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Shown to customers on every product: consumer rights only apply to business sellers
// (Omnibus Directive 2019/2161, Art. 6a CRD).
enum SellerType {
  BUSINESS
  PRIVATE
}

enum MediaKind {
  VIDEO
  IMAGE
}

enum DropStatus {
  PROCESSING // uploaded, waiting for the video to be transcoded
  READY // visible in the feed
  FAILED // transcoding failed
  REMOVED // taken down by the store or by moderation
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum PayoutParty {
  STORE
  COURIER
}

enum PayoutStatus {
  WAITING_FOR_ACCOUNT // the store or courier has not finished Stripe onboarding yet
  SCHEDULED // store payouts are released after the 14-day return window
  PAID
  CANCELLED // fully refunded before release
  FAILED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  avatarUrl    String?
  address      String?
  latitude     Float?
  longitude    Float?

  isActive  Boolean   @default(true) // false = banned or deleted
  deletedAt DateTime? // set when the account is anonymised (GDPR Art. 17)

  store         Store?
  courier       Courier?
  orders        Order[]
  rentals       Rental[]
  returns       Return[]
  refreshTokens RefreshToken[]
  favorites     Favorite[]
  dropLikes     DropLike[]
  reviews       Review[]
  devices       DeviceToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique // SHA-256 hash of the refresh token, never the raw token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId])
}

// ─────────────────────────────────────────────
// STORE  (replaces Vendor)
// ─────────────────────────────────────────────

model Store {
  id            Int           @id @default(autoincrement())
  ownerId       Int           @unique
  owner         User          @relation(fields: [ownerId], references: [id])
  name          String
  description   String?
  category      StoreCategory
  logoUrl       String?
  bannerUrl     String?
  isHomeBased   Boolean       @default(false)
  isVerified    Boolean       @default(false)
  isEcoFriendly Boolean       @default(false)

  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?

  // Business settings
  commissionRate Float      @default(0.10) // platform commission (fraction of item subtotal)
  sellerType     SellerType @default(BUSINESS)
  businessId     String? // Y-tunnus for business sellers (checked during review)
  prepMinutes    Int        @default(10) // time to get an order ready for pickup, used for ETAs

  // Stripe Connect (Express) account that receives the store's payouts
  stripeAccountId String? @unique
  payoutsEnabled  Boolean @default(false)

  // Ratings (denormalised for speed)
  rating       Float @default(0)
  totalReviews Int   @default(0)

  products Product[]
  orders   Order[]
  drops    Drop[]
  reviews  Review[]
  payouts  Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([isVerified, rating])
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  id      Int   @id @default(autoincrement())
  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  name        String
  description String?
  category    String // "Dress", "Lipstick", "Vintage Bag", etc.
  condition   ProductCondition @default(NEW)
  images      String[] // Cloudinary URLs
  tags        String[] // ["eco-friendly", "handmade", "vintage"]

  // Sale
  canBeSold      Boolean @default(true)
  salePriceCents Int? // stored in cents, e.g. 4999 = $49.99

  // Rental
  canBeRented    Boolean @default(false)
  rentalDayCents Int? // price per day in cents
  depositCents   Int? // refundable deposit in cents

  // Inventory
  stockQuantity Int     @default(1)
  isAvailable   Boolean @default(true)

  // Flags
  isEcoFriendly Boolean @default(false)
  isHandmade    Boolean @default(false)
  isSecondHand  Boolean @default(false)
  isFeatured    Boolean @default(false)

  variants     ProductVariant[]
  orderItems   OrderItem[]
  rentalItems  RentalItem[]
  priceChanges PriceChange[]
  favorites    Favorite[]
  drops        Drop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([storeId, isAvailable])
}

// Every sale price a product has had. A "was" price may only be shown when it is the lowest
// price of the 30 days before the reduction (Hintamerkintäasetus / Omnibus Directive, Art. 6a PID).
model PriceChange {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents Int
  changedAt  DateTime @default(now())

  @@index([productId, changedAt])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size             String?
  color            String?
  sku              String? @unique
  stock            Int     @default(1)
  priceAdjustCents Int     @default(0) // adds to base price

  orderItems  OrderItem[]
  rentalItems RentalItem[]

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([productId])
}

// ─────────────────────────────────────────────
// ORDER  (SALE transactions)
// ─────────────────────────────────────────────

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  status OrderStatus @default(PENDING)

  // Pricing (all in cents, server-calculated)
  subtotalCents     Int // sum of items
  deliveryFeeCents  Int @default(299) // €2.99
  commissionCents   Int // 10% of subtotal → Mivia keeps
  sellerPayoutCents Int // subtotal − commission → seller gets
  totalCents        Int // subtotalCents + deliveryFeeCents (what customer pays)

  // Stripe
  stripePaymentIntentId String?
  paymentStatus         PaymentStatus @default(PENDING)
  paidAt                DateTime?
  refundedCents         Int           @default(0)

  courierFeeCents Int @default(0) // what the courier earns for this delivery

  // Lifecycle timestamps
  acceptedAt   DateTime? // courier accepted the job
  pickedUpAt   DateTime?
  deliveredAt  DateTime? // start of the 14-day withdrawal period (Kuluttajansuojalaki 6:14)
  cancelledAt  DateTime?
  cancelReason String?

  // Delivery
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  etaMinutes      Int? // estimate given to the customer when the order was paid

  // Proof of delivery. Photos are private and deleted after 30 days (data minimisation).
  handoverMethod        String? // "IN_PERSON" | "PHOTO"
  deliveryProofPublicId String?
  deliveredLat          Float?
  deliveredLng          Float?

  notes   String?
  items   OrderItem[]
  returns Return[]
  review  Review?
  payouts Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
  @@index([storeId, paymentStatus, createdAt])
  @@index([courierId, status])
  @@index([status, paymentStatus, courierId])
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity  Int
  unitCents Int // price snapshot at time of purchase

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// RENTAL
// ─────────────────────────────────────────────

model Rental {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  status     RentalStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  rentalDays Int // computed: endDate - startDate

  // Pricing (cents)
  subtotalCents    Int // rentalDays × dailyCents
  depositCents     Int // refundable on return
  deliveryFeeCents Int @default(299)
  commissionCents  Int
  totalCents       Int // what customer pays upfront

  stripePaymentIntentId String?
  paymentStatus         PaymentStatus @default(PENDING)

  items  RentalItem[]
  return Return?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
}

model RentalItem {
  id        Int             @id @default(autoincrement())
  rentalId  Int
  rental    Rental          @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity   Int
  dailyCents Int // rate snapshot at time of booking

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([rentalId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// RETURN
// ─────────────────────────────────────────────

model Return {
  id Int @id @default(autoincrement())

  // Linked to either an Order or a Rental (not both)
  orderId  Int?
  order    Order?  @relation(fields: [orderId], references: [id])
  rentalId Int?    @unique
  rental   Rental? @relation(fields: [rentalId], references: [id])

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  reason         ReturnReason
  conditionNote  String? // vendor fills this on receipt
  refundCents    Int? // calculated after inspection
  damageDedCents Int?         @default(0) // deducted if damaged

  status ReturnStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// COURIER
// ─────────────────────────────────────────────

model Courier {
  id           Int     @id @default(autoincrement())
  userId       Int?    @unique
  user         User?   @relation(fields: [userId], references: [id])
  isApproved   Boolean @default(false) // set by an admin after identity/right-to-work checks
  name         String
  phone        String?
  email        String? @unique
  passwordHash String?
  isActive     Boolean @default(true)

  latitude  Float?
  longitude Float?

  // Current assignment tracking
  currentOrderId  Int?
  currentRentalId Int?
  currentReturnId Int?

  // Stripe Connect (Express) account that receives delivery earnings
  stripeAccountId String? @unique
  payoutsEnabled  Boolean @default(false)

  rating       Float @default(0)
  totalRatings Int   @default(0)

  orders  Order[]
  rentals Rental[]
  returns Return[]
  payouts Payout[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([isApproved, isActive])
}

// ─────────────────────────────────────────────
// STRIPE WEBHOOK IDEMPOTENCY
// ─────────────────────────────────────────────

model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// ONE-TIME SIGN-IN CODES (shared by every API instance)
// ─────────────────────────────────────────────

model OtpCode {
  target    String   @id // normalised email or E.164 phone
  codeHash  String // SHA-256(target:code); the code itself is never stored
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// DROPS  (short shoppable videos from stores)
// ─────────────────────────────────────────────

model Drop {
  id        Int     @id @default(autoincrement())
  storeId   Int
  store     Store   @relation(fields: [storeId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  caption       String?
  mediaKind     MediaKind
  mediaPublicId String    @unique // Cloudinary public id (verified signed upload)
  durationSec   Float?
  width         Int?
  height        Int?

  status        DropStatus @default(PROCESSING)
  removedReason String?

  // The store confirmed it owns or has permission for everything in the drop (music, logos, people)
  rightsConfirmedAt DateTime?

  // Engagement counters (denormalised; the source rows live in DropLike / DropView)
  likeCount     Int   @default(0)
  viewCount     Int   @default(0)
  shareCount    Int   @default(0)
  completeCount Int   @default(0) // views watched to (almost) the end
  watchSeconds  Float @default(0)

  likes   DropLike[]
  views   DropView[]
  reports DropReport[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([storeId, createdAt])
  @@index([productId])
}

model DropLike {
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([dropId, userId])
  @@index([userId])
}

// One row per viewer per drop per day, so replays and bots cannot inflate the view count.
model DropView {
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  viewerKey String // "u:<userId>" or "d:<sha256 of the install id>"
  day       DateTime @db.Date
  completed Boolean  @default(false)

  @@id([dropId, viewerKey, day])
}

// Notice-and-action for illegal or harmful content (Digital Services Act, Art. 16).
model DropReport {
  id           Int          @id @default(autoincrement())
  dropId       Int
  drop         Drop         @relation(fields: [dropId], references: [id], onDelete: Cascade)
  reporterId   Int?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([dropId])
}

// ─────────────────────────────────────────────
// FAVOURITES, REVIEWS, PUSH DEVICES
// ─────────────────────────────────────────────

model Favorite {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// Only customers with a delivered order can review, once per order (verified reviews,
// Omnibus Directive: platforms must say how they check that reviews come from real buyers).
model Review {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id])
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  courierId     Int?
  courier       Courier? @relation(fields: [courierId], references: [id])
  storeRating   Int // 1–5
  courierRating Int? // 1–5, not shown publicly
  comment       String?
  isHidden      Boolean  @default(false) // hidden by moderation
  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([courierId])
}

model DeviceToken {
  token     String   @id // Firebase Cloud Messaging registration token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// PAYOUTS  (Stripe Connect transfers to stores and couriers)
// ─────────────────────────────────────────────

model Payout {
  id               Int          @id @default(autoincrement())
  orderId          Int
  order            Order        @relation(fields: [orderId], references: [id])
  party            PayoutParty
  storeId          Int?
  store            Store?       @relation(fields: [storeId], references: [id])
  courierId        Int?
  courier          Courier?     @relation(fields: [courierId], references: [id])
  amountCents      Int
  status           PayoutStatus
  releaseAt        DateTime // earliest moment the transfer may be made
  stripeTransferId String?      @unique
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orderId, party])
  @@index([status, releaseAt])
  @@index([storeId, createdAt])
  @@index([courierId, createdAt])
}

// Lease for background jobs, so only one API instance runs a job at a time.
model JobLease {
  name        String    @id
  lockedUntil DateTime
  lastRunAt   DateTime?
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

// Requests to the Malvoya team from any app; answered by email.
model SupportRequest {
  id        Int           @id @default(autoincrement())
  userId    Int?
  email     String
  app       String // "customer" | "store" | "courier"
  topic     String
  message   String
  orderId   Int?
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}
