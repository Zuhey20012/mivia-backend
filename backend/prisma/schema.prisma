generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // connection URL: see prisma.config.ts (Prisma 7)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  COURIER
  ADMIN
}

enum StoreCategory {
  APPAREL
  COSMETICS
  THRIFT
  ACCESSORIES
  HOME_DECOR
  HANDMADE
  OTHER // ECO_FRIENDLY was removed in 2.12.0 (a generic environmental claim, Directive (EU) 2024/825); those stores became OTHER
}

// Who a product is for (since 2.12.0). Unisex products appear under both Women and Men; beauty defaults to Unisex.
enum Audience {
  WOMEN
  MEN
  KIDS
  UNISEX
}

// Age group within an audience (since 2.12.0, optional): the Kids / Teens rows of the Home switch. Kids' sizes are in cm.
enum AgeGroup {
  BABY // 0-2 years
  TODDLER // 2-4
  KIDS // 4-8
  JUNIOR // 8-14
  TEEN // 13-17
  ADULT
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RentalStatus {
  PENDING
  CONFIRMED
  ACTIVE
  OVERDUE
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  REJECTED
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED_ON_ARRIVAL
  NOT_AS_DESCRIBED
  CHANGED_MIND
  RENTAL_RETURN
  OTHER
}

// How the customer gets the order: a courier brings it, or the customer collects it from the store
// ("Reserve & collect", since 2.8.0).
enum Fulfilment {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Shown to customers on every product: consumer rights only apply to business sellers
// (Omnibus Directive 2019/2161, Art. 6a CRD).
enum SellerType {
  BUSINESS
  PRIVATE
}

enum MediaKind {
  VIDEO
  IMAGE
}

enum VideoStatus {
  PROCESSING // uploaded, waiting for the streaming versions
  READY
  FAILED
}

enum DropStatus {
  PROCESSING // uploaded, waiting for the video to be transcoded
  READY // visible in the feed
  FAILED // transcoding failed
  REMOVED // taken down by the store or by moderation
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum PayoutParty {
  STORE
  COURIER
}

enum PayoutStatus {
  WAITING_FOR_ACCOUNT // the store or courier has not finished Stripe onboarding yet
  SCHEDULED // store payouts are released after the 14-day return window
  PAID
  CANCELLED // fully refunded before release
  FAILED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  googleSub    String?  @unique // Google account id ("sub"): set by Google sign-up or by linking Google in settings
  appleSub     String?  @unique // Sign in with Apple user id (Firebase identities["apple.com"]): opens this account on Apple sign-in
  role         UserRole @default(CUSTOMER)
  avatarUrl    String?
  address      String?
  latitude     Float?
  longitude    Float?

  isActive  Boolean   @default(true) // false = banned or deleted
  deletedAt DateTime? // set when the account is anonymised (GDPR Art. 17)

  store              Store?
  courier            Courier?
  orders             Order[]
  rentals            Rental[]
  returns            Return[]
  refreshTokens      RefreshToken[]
  favorites          Favorite[]
  dropLikes          DropLike[]
  dropSaves          DropSave[] // drops the user saved (since 2.14.0)
  dropHides          DropHide[] // drops the user marked "Not interested" (since 2.14.0)
  reviews            Review[]
  devices            DeviceToken[]
  dropComments       DropComment[]
  follows            StoreFollow[]
  launchAlert        LaunchAlert?
  promoRedemptions   PromoRedemption[]
  liveMessages       LiveMessage[] // chat messages in stores' live streams (since 2.15.0)
  liveBans           LiveBan[] // live streams whose store muted this user
  liveMessageReports LiveMessageReport[] // live chat messages this user reported (2.16)
  sessions           UserSession[] // signed-in devices (refresh-token families, 2.16)
  notices            UserNotice[] // in-app notices: statements of reasons, report outcomes (2.16)

  // Referrals (since 2.8.0): the customer's own invite code, created on first use of GET /me/referral
  referralCode   String?     @unique
  referralsMade  Referral[]  @relation("ReferralReferrer")
  referredBy     Referral?   @relation("ReferralReferee")
  personalPromos PromoCode[] // one-time reward codes only this user can use
  referredOrders Order[]     @relation("OrderReferrer")

  // Language for push notifications and emails ("fi" | "en"), from the apps' Accept-Language or PATCH /me.
  // null = never told: messages go out in English.
  locale               String?
  // Access tokens issued before this moment are refused (a password reset signs every device out)
  tokensValidAfter     DateTime?
  // Agreement accepted at registration (customer terms / seller terms / courier agreement) and its version
  termsAcceptedAt      DateTime?
  termsVersion         String?
  // Users this user blocked (their comments and reviews are hidden for this user), and who blocked this user
  blocks               UserBlock[]           @relation("Blocker")
  blockedBy            UserBlock[]           @relation("Blocked")
  // Every agreement version the user accepted, with proof (since 2.11.0)
  agreementAcceptances AgreementAcceptance[]
  // Known or likely under 18 (since 2.12.0): never gets profiling-based recommendations (DSA Art. 28)
  isMinor              Boolean               @default(false)
  // "I am 18 or older", confirmed at registration or the first social sign-in (since 2.16.0; null = older account)
  ageConfirmedAt       DateTime?

  // Optional pushes (since 2.16.0); service messages (orders, deliveries, payouts, security) are always sent
  notifyFollowedDrops   Boolean @default(true) // new drops from followed stores
  notifyLives           Boolean @default(true) // a followed store goes live
  notifyReferralRewards Boolean @default(true) // invite rewards
  notifyLaunchAlerts    Boolean @default(true) // "Malvoya opens near you"

  // Two-step sign-in with an authenticator app (since 2.13.0; admins). The secret is AES-256-GCM encrypted (key derived
  // from JWT_SECRET); it is set by setup and counts only once totpEnabledAt is set. Never returned by any query by default.
  totpSecret        String?
  totpEnabledAt     DateTime?
  totpLastStep      Int? // last accepted 30-second step: the same code is never accepted twice
  totpRecoveryCodes String[]  @default([]) // SHA-256 of the unused one-time recovery codes
  totpFailures      Int       @default(0) // wrong codes in a row; 5 lock the second step for 15 minutes
  totpLockedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Case-insensitive email lookups on every sign-in path (pg_trgm, docs/scaling/indexes.md (3))
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

model RefreshToken {
  id        Int          @id @default(autoincrement())
  token     String       @unique // SHA-256 hash of the refresh token, never the raw token
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The sign-in (device) this token belongs to (since 2.16.0; null = issued before). Reusing a token that was already
  // exchanged ends the whole sign-in: someone else has a copy.
  sessionId Int?
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime? // exchanged for a new one (kept until it expires, to detect reuse)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId])
  @@index([sessionId])
}

// One sign-in on one device (a refresh-token family, since 2.16.0): listed under Settings → Signed-in devices.
// Access tokens carry its id (sid), so ending it ends that device at once.
model UserSession {
  id          Int            @id @default(autoincrement())
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      String? // "Malvoya app (Android)", "Chrome on Windows"… from the User-Agent; never the IP address
  mfa         Boolean        @default(false) // passed two-step sign-in
  createdAt   DateTime       @default(now())
  lastUsedAt  DateTime       @default(now())
  revokedAt   DateTime?
  // The password (or a code) was entered again: payout links work until then (10 minutes)
  reauthUntil DateTime?
  tokens      RefreshToken[]

  @@index([userId, revokedAt])
  @@index([revokedAt])
}

// Small shared counters with an expiry (since 2.16.0): sign-in failures, SMS per day, code guesses, failed payments.
// Fixed windows, incremented atomically in SQL, so every API instance sees the same numbers.
model Counter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Runtime switches set by admins (since 2.16.0): { on: boolean, message?: string } per key, audited, cached 30 s.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById Int?
  updatedAt   DateTime @updatedAt
}

// In-app notices to one user (since 2.16.0): statements of reasons when their content is hidden or removed (DSA
// Art. 17) and the outcome of their reports (DSA Art. 16(5)). Also emailed. Deleted with the account.
model UserNotice {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "statement_of_reasons" | "report_outcome"
  titleEn   String
  titleFi   String
  bodyEn    String
  bodyFi    String
  entity    String? // "DropComment" | "Review" | "LiveMessage" | "Drop" | "Product" | "LiveStream"
  entityId  Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, id])
}

// A new item in System → attention that admins were already told about (ops-alerts, since 2.16.0): sha-256 of the text
model OpsAlert {
  hash        String   @id
  text        String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// ─────────────────────────────────────────────
// STORE  (replaces Vendor)
// ─────────────────────────────────────────────

model Store {
  id          Int           @id @default(autoincrement())
  ownerId     Int           @unique
  owner       User          @relation(fields: [ownerId], references: [id])
  name        String
  description String?
  category    StoreCategory
  logoUrl     String?
  bannerUrl   String?
  isHomeBased Boolean       @default(false)
  isVerified  Boolean       @default(false)

  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?

  // Business settings
  commissionRate Float      @default(0) // platform commission (fraction of item subtotal); none since 2.13.0 (0 for every store)
  sellerType     SellerType @default(BUSINESS)
  businessId     String? // Y-tunnus for business sellers (checked during review)
  prepMinutes    Int        @default(10) // time to get an order ready for pickup, used for ETAs

  // Availability: the store can pause new orders at any time, and opening hours (Europe/Helsinki)
  // close it automatically. openingHours = { "mon": [["09:00","18:00"]], ... }; null = always open.
  acceptingOrders Boolean @default(true)
  openingHours    Json?

  // Stripe Connect (Express) account that receives the store's payouts
  stripeAccountId String? @unique
  payoutsEnabled  Boolean @default(false)

  // Ratings (denormalised for speed)
  rating       Float @default(0)
  totalReviews Int   @default(0)

  products   Product[]
  orders     Order[]
  drops      Drop[]
  reviews    Review[]
  payouts    Payout[]
  followers  StoreFollow[]
  importJobs ImportJob[]
  taxInfo    StoreTaxInfo?
  lives      LiveStream[]

  // Live shopping (2.15): when followers last heard "<store> is live" (at most once per 6 h)
  liveNotifiedAt DateTime?

  // DAC7 reminders to stores with sales this year and incomplete tax data: at most every 30 days, 2 per year
  taxReminderAt    DateTime?
  taxReminderCount Int       @default(0) // reminders sent in taxReminderYear
  taxReminderYear  Int?

  // Automatic business check (since 2.11.0): the Y-tunnus looked up in the PRH/YTJ open data. Pre-fills the admin's
  // decision, never approves by itself. Status: matched | name_mismatch | not_found | inactive | unavailable (null = not checked)
  businessCheckStatus    String?
  businessRegisteredName String?
  businessRegisteredAt   DateTime? @db.Date
  businessCheckedAt      DateTime?
  // Every onboarding step except approval done: set once, when the admin was told (System → ready for approval)
  readyForApprovalAt     DateTime?

  // An approved store changed its name, address or map position (since 2.16.0): shown in System → attention until an
  // admin approves it again. Nothing is unapproved automatically.
  changedAfterApprovalAt DateTime?
  changedFields          String[]  @default([])

  // Product-safety self-certification (GPSR Art. 22(10)(b), since 2.12.0): "I only offer products that comply with EU
  // law", given once before the first product is published; the version is a hash of the pledge text accepted
  safetyPledgeAt      DateTime?
  safetyPledgeVersion String?

  economicOperators EconomicOperator[]
  certificates      Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([isVerified, rating])
  @@index([isVerified, readyForApprovalAt])
  @@index([changedAfterApprovalAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin) // product search matches shop names (pg_trgm)
}

// Seller identity and tax data the platform must collect and report to Vero once a year (DAC7, Council
// Directive (EU) 2021/514, implemented in Finland by Vero; report due by 31 January). Kept 10 years after the reporting year.
// BUSINESS: legal name + Store.businessId (Y-tunnus) + optional VAT number + registered address.
// PRIVATE: legal name + date of birth + tax identification number (TIN) + primary address.
// The TIN (for Finns the henkilötunnus) is encrypted at rest (AES-256-GCM, DATA_ENCRYPTION_KEY) and only
// decrypted for the admin DAC7 report; the owner sees it masked.
model StoreTaxInfo {
  id           Int       @id @default(autoincrement())
  storeId      Int       @unique
  store        Store     @relation(fields: [storeId], references: [id])
  legalName    String
  dateOfBirth  DateTime? @db.Date // private sellers only
  tinEncrypted String? // private sellers only: "v1:<base64 iv|tag|ciphertext>"
  vatNumber    String? // business sellers, optional (e.g. FI12345678)
  addressLine  String
  postalCode   String
  city         String
  country      String // ISO 3166-1 alpha-2, e.g. "FI"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  id      Int   @id @default(autoincrement())
  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  name        String
  description String?
  // Legacy free text kept for older app builds: since 2.12.0 the subcategory's English name ("Dresses")
  category    String
  condition   ProductCondition @default(NEW)
  images      String[] // Cloudinary URLs
  tags        String[] // ["handmade", "vintage"]; generic green words are never stored

  // Taxonomy and category-specific data (since 2.12.0). categoryId is always a subcategory (a leaf of the tree);
  // null = not categorised yet (cannot be published). attributes are validated per template (catalog/attributes.ts).
  categoryId    Int?
  categoryRef   Category? @relation(fields: [categoryId], references: [id])
  audience      Audience  @default(UNISEX)
  ageGroup      AgeGroup?
  attributes    Json      @default("{}")
  // Nominal content of the pack (cosmetics, fragrance): the unit price per litre / kg is computed from it
  contentAmount Float?
  contentUnit   String? // "ml" | "g" | "pcs"

  // Hygiene seal (cosmetics, fragrance, sealed piercing jewellery/earrings only): no right of withdrawal once opened
  hygieneSealed Boolean @default(false)

  // Product safety (GPSR Art. 19): manufacturer, EU responsible person, type/model, identifiers, warnings FI + SV
  manufacturerId      Int?
  manufacturer        EconomicOperator? @relation("ProductManufacturer", fields: [manufacturerId], references: [id])
  responsiblePersonId Int?
  responsiblePerson   EconomicOperator? @relation("ProductResponsiblePerson", fields: [responsiblePersonId], references: [id])
  productModel        String?
  batchOrSerial       String?
  warningsFi          String?
  warningsSv          String?
  warningsEn          String?
  noWarnings          Boolean           @default(false) // the label carries no warnings (an explicit choice, not a blank)
  safetyImages        String[] // photos of the label, warning panel, instructions

  // Locked by Malvoya: the store cannot make it visible again ("RECALL" = product safety recall, "ADMIN" = notice decision)
  lockedAt     DateTime?
  lockedReason String?
  // Catalogue import put it on hold (out-of-scope goods, e.g. candles or food supplements): cannot be published
  importHold   String?

  // Sale
  canBeSold      Boolean @default(true)
  salePriceCents Int? // stored in cents, e.g. 4999 = $49.99

  // Rental
  canBeRented    Boolean @default(false)
  rentalDayCents Int? // price per day in cents
  depositCents   Int? // refundable deposit in cents

  // Inventory
  stockQuantity Int     @default(1)
  isAvailable   Boolean @default(true)

  // Catalogue import (Shopify feed or CSV): re-importing the same item updates it instead of duplicating it
  externalSource String? // "SHOPIFY" | "WOOCOMMERCE" | "CSV"
  externalId     String? // id in the source (Shopify product id, CSV external_id or name)
  gtin           String? // EAN/GTIN barcode, 8–14 digits
  importJobId    Int? // the import that last created or updated it (publish works per job)
  importDraft    Boolean    @default(false) // created by an import and not yet published or hidden by the store
  importJob      ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  // Deleted by the store but kept, because orders, rentals, drops or a catalogue import still point at it.
  // A deleted product is hidden everywhere, also from the store's own lists.
  deletedAt DateTime?

  // Flags
  isHandmade   Boolean @default(false)
  isSecondHand Boolean @default(false)
  isFeatured   Boolean @default(false)

  variants     ProductVariant[]
  orderItems   OrderItem[]
  rentalItems  RentalItem[]
  priceChanges PriceChange[]
  favorites    Favorite[]
  drops        Drop[]
  videos       ProductVideo[]
  facets       ProductFacet[]
  certificates ProductCertificate[]
  reports      ProductReport[]
  recalls      RecallProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@unique([storeId, externalSource, externalId])
  @@index([storeId, isAvailable])
  @@index([importJobId])
  @@index([storeId, deletedAt])
  @@index([categoryId, isAvailable])
  @@index([audience, ageGroup])
  @@index([manufacturerId])
  @@index([responsiblePersonId])
  @@index([gtin])
  // Product search `ILIKE '%term%'` (pg_trgm, docs/scaling/indexes.md (2))
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([category(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
}

// Every sale price a product has had. A "was" price may only be shown when it is the lowest
// price of the 30 days before the reduction (Hintamerkintäasetus / Omnibus Directive, Art. 6a PID).
model PriceChange {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents Int
  changedAt  DateTime @default(now())

  @@index([productId, changedAt])
}

/// Product videos (with sound) shown in the product gallery; uploaded by the store through a signed upload.
model ProductVideo {
  id          Int         @id @default(autoincrement())
  productId   Int
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicId    String      @unique // Cloudinary public id (verified signed upload)
  status      VideoStatus @default(PROCESSING)
  durationSec Float?
  width       Int?
  height      Int?
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([productId, status])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size             String?
  color            String?
  sku              String? @unique
  stock            Int     @default(1)
  priceAdjustCents Int     @default(0) // adds to base price

  // Option data (since 2.12.0): colour family, shade (makeup/nails), size measurements in cm, content per option
  colourFamily  String?
  shadeName     String?
  shadeHex      String? // "#RRGGBB"
  shadeFamily   String?
  undertone     String?
  finish        String?
  measurements  Json? // { chest, waist, hips, insideLeg, height, length, footLengthCm, ... } in cm
  contentAmount Float?
  contentUnit   String? // "ml" | "g" | "pcs"

  orderItems  OrderItem[]
  rentalItems RentalItem[]

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([productId])
}

// ─────────────────────────────────────────────
// ORDER  (SALE transactions)
// ─────────────────────────────────────────────

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  status     OrderStatus @default(PENDING)
  fulfilment Fulfilment  @default(DELIVERY)

  // Pricing (all in cents, server-calculated)
  subtotalCents     Int // sum of items
  deliveryFeeCents  Int @default(299) // €2.99
  commissionCents   Int // 10% of subtotal → Mivia keeps
  sellerPayoutCents Int // subtotal − commission → seller gets
  totalCents        Int // subtotal + delivery + service fee + small-order fee + tip − discount (what the customer pays)

  // Platform fees and platform-funded discount (all off by default; see utils/pricing.ts)
  serviceFeeCents    Int              @default(0)
  smallOrderFeeCents Int              @default(0)
  discountCents      Int              @default(0) // promo discount paid by Malvoya: store and courier pay are not reduced
  promoCodeId        Int?
  promoCode          PromoCode?       @relation(fields: [promoCodeId], references: [id])
  promoRedemption    PromoRedemption?
  // Invite code of another customer used on this (first) order; the discount is platform-funded like a promo.
  // Never shown to the store or courier (omitted from every order query, see lib/prisma.ts).
  referrerId         Int?
  referrer           User?            @relation("OrderReferrer", fields: [referrerId], references: [id])
  referral           Referral?

  // Stripe
  stripePaymentIntentId String?
  paymentStatus         PaymentStatus @default(PENDING)
  paidAt                DateTime?
  refundedCents         Int           @default(0)

  courierFeeCents Int   @default(0) // what the courier earns for this delivery, tip and waiting included (= courierPay.totalCents)
  tipCents        Int   @default(0) // optional tip chosen at checkout; goes to the courier in full
  // How courierFeeCents was computed (utils/courierPay.ts): { mode, baseCents, distanceKm, distanceCents, waitMinutes,
  // waitCents, tipCents, totalCents, formula, explanation: { en, fi } }. Null on orders made before 2.7.
  courierPay      Json?

  // Lifecycle timestamps
  confirmedAt      DateTime? // store accepted the order
  acceptedAt       DateTime? // courier accepted the job
  courierArrivedAt DateTime? // courier checked in at the shop (starts the paid waiting clock)
  pickedUpAt       DateTime?
  deliveredAt      DateTime? // start of the 14-day withdrawal period (Kuluttajansuojalaki 6:14)
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String? // "STORE" when the store declined or cancelled it (cancelReason is then the store's own words)

  // Delivery
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  etaMinutes      Int? // estimate given to the customer when the order was paid (null for scheduled orders)

  // Scheduled delivery (since 2.9.0): the customer picked a platform slot (DELIVERY_SLOTS, Europe/Helsinki).
  // Couriers are offered the job from scheduledStart − store prepMinutes − 15 min; null = as soon as possible.
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  dispatchStartedAt DateTime? // the first courier offer went out (the customer was told), set once

  // Proof of delivery. Photos are private and deleted after 30 days (data minimisation).
  handoverMethod        String? // "IN_PERSON" | "PHOTO"
  deliveryProofPublicId String?
  deliveredLat          Float?
  deliveredLng          Float?

  // Reserve & collect: the customer shows this 6-digit code at the store. Created when the order is paid,
  // shown to the customer only (omitted from every order query, see lib/prisma.ts).
  pickupCode           String?
  pickupFailedAttempts Int       @default(0) // wrong codes since the last lock
  pickupLockedUntil    DateTime? // 5 wrong codes lock the handover for 15 minutes
  readyAt              DateTime? // the store marked the order ready (PROCESSING)
  pickupRemindedAt     DateTime? // "your order is waiting" push, sent once

  // Orders of 80 € or more (since 2.16.0): the customer tells the courier this 4-digit PIN at an in-person handover.
  // Shown to the customer only, while the order is on its way (omitted from every order query, see lib/prisma.ts).
  // Wrong PINs use pickupFailedAttempts / pickupLockedUntil (delivery orders never use them for pickup).
  handoverPin String?

  // Fraud signals and disputes (since 2.16.0)
  cardFingerprint       String? // Stripe's card fingerprint of the payment (same card = same value, across accounts)
  disputedAt            DateTime? // the customer's bank opened a chargeback (charge.dispute.created)
  disputeStatus         String? // Stripe dispute status: needs_response, under_review, won, lost, warning_* …
  disputeId             String?
  disputeReason         String?
  externalRefundedCents Int       @default(0) // refunded outside Malvoya (Stripe dashboard), synced from charge.refunded
  // Where to send the receipt when the account has no email address (phone sign-in), optional at checkout
  receiptEmail          String?

  // Watchdog bookkeeping (see services/orderWatchdog.ts)
  storeRemindedAt         DateTime?
  lastOfferAt             DateTime?
  courierSearchNotifiedAt DateTime?
  arrivingNotifiedAt      DateTime? // "your courier is arriving" push, sent once

  // The courier is at the address and cannot hand the order over (since 2.10.0). From 10 minutes later the courier
  // may take it back to the shop: the order is cancelled and the items refunded; delivery fee and tip are not.
  deliveryProblemAt     DateTime?
  deliveryProblemReason String? // "CUSTOMER_UNAVAILABLE" | "WRONG_ADDRESS" | "OTHER"
  deliveryProblemNote   String?
  returnedToStoreAt     DateTime? // the courier took the order back to the shop (items refunded, courier paid)
  returnReceivedAt      DateTime? // the store confirmed it has the items back

  notes    String?
  items    OrderItem[]
  returns  Return[]
  review   Review?
  payouts  Payout[]
  messages OrderMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
  @@index([storeId, paymentStatus, createdAt])
  @@index([courierId, status])
  @@index([status, paymentStatus, courierId])
  @@index([promoCodeId])
  @@index([fulfilment, status, readyAt])
  @@index([referrerId])
  @@index([deliveredAt])
  @@index([paidAt])
  @@index([scheduledStart])
  @@index([deliveryProblemAt])
  @@index([cancelledAt])
  // Order watchdog every minute (docs/scaling/indexes.md (1)): paid orders waiting for the store, unpaid checkouts
  @@index([status, paymentStatus, paidAt])
  @@index([status, paymentStatus, createdAt])
  @@index([stripePaymentIntentId])
  @@index([cardFingerprint])
  @@index([disputedAt])
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity      Int
  unitCents     Int // price snapshot at time of purchase
  // The product was hygiene-sealed when bought (snapshot): no withdrawal once the seal is opened (KSL 6:16)
  hygieneSealed Boolean @default(false)

  returnItems ReturnItem[]

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([orderId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// RENTAL
// ─────────────────────────────────────────────

model Rental {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  status     RentalStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  rentalDays Int // computed: endDate - startDate

  // Pricing (cents)
  subtotalCents    Int // rentalDays × dailyCents
  depositCents     Int // refundable on return
  deliveryFeeCents Int @default(299)
  commissionCents  Int
  totalCents       Int // what customer pays upfront

  stripePaymentIntentId String?
  paymentStatus         PaymentStatus @default(PENDING)

  items  RentalItem[]
  return Return?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
}

model RentalItem {
  id        Int             @id @default(autoincrement())
  rentalId  Int
  rental    Rental          @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity   Int
  dailyCents Int // rate snapshot at time of booking

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([rentalId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// RETURN
// ─────────────────────────────────────────────

model Return {
  id Int @id @default(autoincrement())

  // Linked to either an Order or a Rental (not both)
  orderId  Int?
  order    Order?  @relation(fields: [orderId], references: [id])
  rentalId Int?    @unique
  rental   Rental? @relation(fields: [rentalId], references: [id])

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courierId Int?
  courier   Courier? @relation(fields: [courierId], references: [id])

  reason         ReturnReason
  conditionNote  String? // the customer's note on the return; the store may add to it on receipt
  storeNote      String? // the store's reason or notes (required when it rejects), shown to the customer
  refundCents    Int? // calculated after inspection
  damageDedCents Int?         @default(0) // deducted if damaged
  sealIntact     Boolean? // the customer's answer for hygiene-sealed items (null = no sealed item, or a fault reason)

  status ReturnStatus @default(REQUESTED)

  // What is being returned (since 2.8.0). Returns made before have no rows and cover the whole order.
  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([userId, createdAt])
  @@index([orderId])
}

// One returned order line (and how many of it) of a return.
model ReturnItem {
  id          Int       @id @default(autoincrement())
  returnId    Int
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

// ─────────────────────────────────────────────
// COURIER
// ─────────────────────────────────────────────

model Courier {
  id           Int     @id @default(autoincrement())
  userId       Int?    @unique
  user         User?   @relation(fields: [userId], references: [id])
  isApproved   Boolean @default(false) // set by an admin after identity/right-to-work checks
  name         String
  phone        String?
  email        String? @unique
  passwordHash String?
  isActive     Boolean @default(true)

  latitude   Float?
  longitude  Float?
  locationAt DateTime? // when latitude/longitude were last reported; older than 2 minutes = position unknown

  // Current assignment tracking
  currentOrderId  Int?
  currentRentalId Int?
  currentReturnId Int?

  // Stripe Connect (Express) account that receives delivery earnings
  stripeAccountId String? @unique
  payoutsEnabled  Boolean @default(false)

  rating       Float @default(0)
  totalRatings Int   @default(0)

  // Onboarding (since 2.11.0): vehicle (bicycle | ebike | moped | scooter | car | on_foot), when the courier
  // acknowledged how location is used, and when every step except approval was done (admin told once)
  vehicleType          String?
  locationDisclosureAt DateTime?
  readyForApprovalAt   DateTime?

  orders    Order[]
  rentals   Rental[]
  returns   Return[]
  payouts   Payout[]
  reviews   Review[]
  incidents CourierIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Query-path indexes (Postgres does not index foreign keys automatically)
  @@index([isApproved, isActive])
  @@index([isApproved, readyForApprovalAt])
}

// ─────────────────────────────────────────────
// STRIPE WEBHOOK IDEMPOTENCY
// ─────────────────────────────────────────────

model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// ONE-TIME SIGN-IN CODES (shared by every API instance)
// ─────────────────────────────────────────────

model OtpCode {
  target    String   @id // normalised email or E.164 phone
  codeHash  String // SHA-256(target:code); the code itself is never stored
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// DROPS  (short shoppable videos from stores)
// ─────────────────────────────────────────────

model Drop {
  id        Int     @id @default(autoincrement())
  storeId   Int
  store     Store   @relation(fields: [storeId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  caption       String?
  mediaKind     MediaKind
  mediaPublicId String    @unique // Cloudinary public id (verified signed upload)
  durationSec   Float?
  width         Int?
  height        Int?

  status        DropStatus @default(PROCESSING)
  removedReason String?

  // The store confirmed it owns or has permission for everything in the drop (music, logos, people)
  rightsConfirmedAt DateTime?

  // Photo drops (since 2.13.0): up to 9 more photos after mediaPublicId, in order, shown as a slideshow, and an optional
  // sound track the store uploaded (Cloudinary audio, delivered as MP3). Video drops keep their own sound.
  extraImagePublicIds String[] @default([])
  audioPublicId       String?
  audioDurationSec    Float?

  // Reels (since 2.14.0): a sound from Malvoya's licensed library (instead of audioPublicId; the store's own sound or
  // voice-over may now also go on a video), how it plays with the video's own sound ("MIX" | "REPLACE", videos with a
  // sound only) and which part of the video plays (seconds; null = all of it; the file is not cut)
  soundId      Int?
  sound        Sound?  @relation(fields: [soundId], references: [id])
  soundMode    String?
  trimStartSec Float?
  trimEndSec   Float?

  // Engagement counters (denormalised; the source rows live in DropLike / DropView)
  likeCount     Int   @default(0)
  viewCount     Int   @default(0)
  shareCount    Int   @default(0)
  completeCount Int   @default(0) // views watched to (almost) the end
  watchSeconds  Float @default(0)
  commentCount  Int   @default(0) // visible comments
  saveCount     Int   @default(0) // users who saved it (DropSave)

  likes    DropLike[]
  views    DropView[]
  reports  DropReport[]
  comments DropComment[]
  saves    DropSave[]
  hides    DropHide[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([storeId, createdAt])
  @@index([productId])
  @@index([soundId, status, publishedAt])
}

// A viewer saved a drop to watch later (since 2.14.0). Newest first in GET /me/saved-drops (paged by id).
model DropSave {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dropId])
  @@index([userId, id])
  @@index([dropId])
}

// "Not interested" (since 2.14.0): the drop never shows in this user's feeds, store or sound lists again (until undone).
model DropHide {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, dropId])
  @@index([dropId])
}

// Malvoya's sound library (since 2.14.0): tracks Malvoya holds a licence for (bought commercial licence, CC0, own
// recordings), added by admins only and offered to every store. Stores' own uploads are never shared.
model Sound {
  id          Int      @id @default(autoincrement())
  title       String
  artist      String?
  publicId    String   @unique // Cloudinary audio (resource type video) under malvoya/sounds/
  durationSec Float
  licence     String // what licence and from whom
  licenceUrl  String?
  active      Boolean  @default(true) // false = no longer offered to stores; drops using it keep playing
  createdById Int // the admin who added it
  drops       Drop[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, id])
}

model DropLike {
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([dropId, userId])
  @@index([userId])
}

// One row per viewer per drop per day, so replays and bots cannot inflate the view count.
model DropView {
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  viewerKey String // "u:<userId>" or "d:<sha256 of the install id>"
  day       DateTime @db.Date
  completed Boolean  @default(false)

  @@id([dropId, viewerKey, day])
}

// Notice-and-action for illegal or harmful content (Digital Services Act, Art. 16).
model DropReport {
  id           Int          @id @default(autoincrement())
  dropId       Int
  drop         Drop         @relation(fields: [dropId], references: [id], onDelete: Cascade)
  reporterId   Int?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([dropId])
}

enum CommentStatus {
  VISIBLE
  HIDDEN // three distinct reports: hidden until an admin looks at it
  REMOVED // deleted by its author, the store or an admin
}

/// Comments on drops. Shown with the commenter's first name only.
model DropComment {
  id          Int           @id @default(autoincrement())
  dropId      Int
  drop        Drop          @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  status      CommentStatus @default(VISIBLE)
  reportCount Int           @default(0)
  createdAt   DateTime      @default(now())

  reports DropCommentReport[]

  @@index([dropId, status, id])
  @@index([userId, createdAt])
  @@index([status, reportCount])
}

model DropCommentReport {
  commentId  Int
  comment    DropComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId Int
  reason     String
  createdAt  DateTime    @default(now())

  @@id([commentId, reporterId])
}

/// A shopper following a store: its new drops reach them in the Following feed and by push.
/// "Tell me when Malvoya opens near me": one pinned location per user, notified once when the
/// first store goes live within reach. Deleted with the account.
model LaunchAlert {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  area       String? // what the customer typed or picked, shown in the admin demand list
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([notifiedAt])
}

model StoreFollow {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  muted     Boolean  @default(false) // still followed, but no pushes from this store (2.16)
  createdAt DateTime @default(now())

  @@id([userId, storeId])
  @@index([storeId])
}

// ─────────────────────────────────────────────
// FAVOURITES, REVIEWS, PUSH DEVICES
// ─────────────────────────────────────────────

model Favorite {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// Only customers with a delivered order can review, once per order (verified reviews,
// Omnibus Directive: platforms must say how they check that reviews come from real buyers).
model Review {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id])
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  courierId     Int?
  courier       Courier? @relation(fields: [courierId], references: [id])
  storeRating   Int // 1–5
  courierRating Int? // 1–5, not shown publicly
  comment       String?
  isHidden      Boolean  @default(false) // hidden by moderation
  createdAt     DateTime @default(now())

  reports ReviewReport[]

  @@index([storeId, createdAt])
  @@index([courierId])
}

// Someone reported a review (DSA notice-and-action, Google Play UGC policy). An admin hides it or keeps it.
model ReviewReport {
  id         Int       @id @default(autoincrement())
  reviewId   Int
  review     Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId Int
  reason     String
  resolvedAt DateTime? // an admin decided
  resolution String? // "HIDDEN" | "KEPT"
  createdAt  DateTime  @default(now())

  @@unique([reviewId, reporterId])
  @@index([resolvedAt, createdAt])
}

// A user blocked another user: the blocked user's drop comments and reviews are hidden for the blocker.
model UserBlock {
  blockerId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Order chat (customer and courier). Deleted 30 days after the order was completed or cancelled.
model OrderMessage {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderRole String // CUSTOMER | COURIER | VENDOR | ADMIN
  senderId   Int // the sender's user id
  text       String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([senderId])
}

model DeviceToken {
  token     String   @id // Firebase Cloud Messaging registration token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// PAYOUTS  (Stripe Connect transfers to stores and couriers)
// ─────────────────────────────────────────────

model Payout {
  id               Int          @id @default(autoincrement())
  orderId          Int
  order            Order        @relation(fields: [orderId], references: [id])
  party            PayoutParty
  storeId          Int?
  store            Store?       @relation(fields: [storeId], references: [id])
  courierId        Int?
  courier          Courier?     @relation(fields: [courierId], references: [id])
  amountCents      Int
  status           PayoutStatus
  releaseAt        DateTime // earliest moment the transfer may be made
  stripeTransferId String?      @unique
  linkedToCharge   Boolean      @default(false) // transfer was tied to the order's charge (source_transaction)
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orderId, party])
  @@index([status, releaseAt])
  @@index([storeId, createdAt])
  @@index([courierId, createdAt])
}

// Lease for background jobs, so only one API instance runs a job at a time.
model JobLease {
  name        String    @id
  lockedUntil DateTime
  lastRunAt   DateTime?
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

// Requests to the Malvoya team from any app; answered by email.
model SupportRequest {
  id        Int           @id @default(autoincrement())
  userId    Int?
  email     String
  app       String // "customer" | "store" | "courier"
  topic     String
  message   String
  orderId   Int?
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────
// PROMO CODES (platform-funded discounts)
// ─────────────────────────────────────────────

enum PromoKind {
  PERCENT // value = percent of the item subtotal (1–100)
  AMOUNT // value = cents off
}

model PromoCode {
  id               Int       @id @default(autoincrement())
  code             String    @unique // stored uppercase
  description      String
  kind             PromoKind
  value            Int
  maxDiscountCents Int? // cap for PERCENT codes
  minSubtotalCents Int       @default(0)
  firstOrderOnly   Boolean   @default(false) // only for users without an earlier paid order
  maxRedemptions   Int? // across all customers; null = unlimited
  perUserLimit     Int       @default(1)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  // Personal code: only this user can use it (referral rewards). null = anyone.
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now())

  orders      Order[]
  redemptions PromoRedemption[]
  referral    Referral?

  @@index([active, createdAt])
  @@index([userId])
}

// One row per PAID order that used a code; deleted again if that order is cancelled before delivery.
model PromoRedemption {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique
  order         Order     @relation(fields: [orderId], references: [id])
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  promoCodeId   Int
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id])
  discountCents Int
  createdAt     DateTime  @default(now())

  @@index([promoCodeId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// CATALOGUE IMPORT (Shopify public feed or CSV), run in-process; products arrive as hidden drafts
// ─────────────────────────────────────────────

enum ImportSource {
  SHOPIFY
  CSV
  WOOCOMMERCE
}

enum ImportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model ImportJob {
  id                Int          @id @default(autoincrement())
  storeId           Int
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  source            ImportSource
  status            ImportStatus @default(QUEUED)
  sourceRef         String? // the Shopify / WooCommerce shop domain; null for CSV
  total             Int          @default(0) // products found in the source
  created           Int          @default(0)
  updated           Int          @default(0)
  skipped           Int          @default(0)
  uploads           Int          @default(0) // photos copied to Cloudinary by this job (daily cap per store)
  errors            Json         @default("[]") // [{ item, message, level: "error" | "warning" }], at most 200
  rightsConfirmedAt DateTime // the store confirmed it may use these photos and texts
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt // progress heartbeat: a job without progress for 15 min is marked FAILED
  finishedAt        DateTime?

  products Product[]

  @@index([storeId, createdAt])
  @@index([status, updatedAt])
}

// ─────────────────────────────────────────────
// REFERRALS (off unless REFERRAL_DISCOUNT_CENTS is set)
// ─────────────────────────────────────────────

// A new customer's first order used another customer's invite code. Written when that order is paid,
// deleted again if it is cancelled before delivery. One per new customer.
model Referral {
  id                Int        @id @default(autoincrement())
  referrerId        Int
  referrer          User       @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeId         Int        @unique
  referee           User       @relation("ReferralReferee", fields: [refereeId], references: [id])
  orderId           Int        @unique
  order             Order      @relation(fields: [orderId], references: [id])
  rewardedAt        DateTime? // the referrer's reward code was issued (the referee's order was delivered)
  rewardPromoCodeId Int?       @unique
  rewardPromoCode   PromoCode? @relation(fields: [rewardPromoCodeId], references: [id])
  createdAt         DateTime   @default(now())

  @@index([referrerId, createdAt])
}

// ─────────────────────────────────────────────
// ADMIN AUDIT LOG (who changed what, when)
// ─────────────────────────────────────────────

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int // the admin user who made the change
  action    String // e.g. "store.commission"
  entity    String // e.g. "Store"
  entityId  Int
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

// ─────────────────────────────────────────────
// LEGAL DOCUMENT VERSIONS AND ACCEPTANCES (since 2.11.0)
// ─────────────────────────────────────────────

// One row per published version of a legal text, with the full text as it was published. The first version of each
// document is created at start-up (effective at once); every later one only when an admin publishes it with a notice
// period (seller terms ≥ 15 days, EU P2B Art. 3; courier agreement ≥ 15 days; customer terms and privacy ≥ 0 days),
// so a deploy never changes a contract by itself. The current version is the newest one whose effectiveAt has passed.
model LegalVersion {
  id                    Int       @id @default(autoincrement())
  doc                   String // "terms" | "seller-terms" | "courier-agreement" | "privacy"
  version               String // "<file>@<first 12 hex of the SHA-256 of the text>", same format as User.termsVersion
  textSnapshot          String // the full Markdown text of this version
  sha256                String
  publishedAt           DateTime  @default(now())
  effectiveAt           DateTime
  summaryEn             String
  summaryFi             String
  noticeDays            Int // whole days between publishing and taking effect
  legalObligation       Boolean   @default(false) // shorter notice because the law requires the change
  legalObligationReason String?
  publishedById         Int? // admin user; null for the first version created at start-up
  notifiedAt            DateTime? // when the change notices went out
  notifiedCount         Int       @default(0)

  @@unique([doc, version])
  @@index([doc, effectiveAt])
}

// Clickwrap proof: who accepted which version of which document, when, from where (IP truncated to /24 or /48),
// with which app. Kept for the life of the account + 10 years (contract proof), also after the account is deleted.
model AgreementAcceptance {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc        String
  version    String
  acceptedAt DateTime @default(now())
  ip         String? // truncated: IPv4 /24, IPv6 /48
  userAgent  String? // at most 200 characters
  appVersion String? // X-App-Version header, when the app sends it
  method     String // "register" | "in_app" | "admin_import"

  @@unique([userId, doc, version])
  @@index([doc, version])
}

// ─────────────────────────────────────────────
// CATEGORY TAXONOMY, PRODUCT FACETS, SAFETY AND CERTIFICATES (since 2.12.0)
// ─────────────────────────────────────────────

// The category tree (docs/compliance/product-data-spec.md §1.3), seeded at start-up from catalog/taxonomy.ts. Slugs never
// change; admins may rename, reorder and hide nodes. template = the attribute template of a subcategory (null for top
// levels); collections (second-hand) are saved filters with no products filed under them.
model Category {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  parentId     Int?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  nameEn       String
  nameFi       String
  icon         String // Material icon name
  tileColor    String // Birch palette name: lilac, clay, mint, sunshineLight, peach, sand
  sort         Int        @default(0)
  template     String?
  isCollection Boolean    @default(false)
  active       Boolean    @default(true)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId, sort])
}

// Filterable values of a product (product attributes and option values), rewritten on every save, so search filters and
// facet counts use one index instead of JSON scans.
model ProductFacet {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@id([productId, key, value])
  @@index([key, value])
}

// Manufacturer / EU responsible person / cosmetics responsible person records of a store, reusable across products
// (GPSR Art. 19(a)-(b), Cosmetics Regulation Art. 4 and 19(1)(a)). One record can serve in several roles.
model EconomicOperator {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  addressLine String
  postalCode  String
  city        String
  countryCode String // ISO 3166-1 alpha-2
  email       String?
  url         String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manufacturedProducts Product[] @relation("ProductManufacturer")
  responsibleProducts  Product[] @relation("ProductResponsiblePerson")

  @@index([storeId])
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REJECTED
}

// A third-party certificate a store holds (EU Ecolabel, Nordic Swan, GOTS, ...), replacing the old self-declared eco flag.
// Only VERIFIED certificates whose validUntil has not passed are shown to shoppers or used in filters.
model Certificate {
  id                   Int                  @id @default(autoincrement())
  storeId              Int
  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scheme               String // key from catalog/certificates.ts (fixed list)
  licenceNumber        String
  holderName           String
  scope                String // "whole_product" | "component"
  componentDescription String?
  validUntil           DateTime             @db.Date
  evidenceUrl          String // the certificate file, uploaded to the store's own folder
  publicVerifyUrl      String?
  status               CertificateStatus    @default(PENDING)
  reviewedById         Int?
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  products             ProductCertificate[]

  @@index([status, createdAt])
  @@index([storeId])
}

model ProductCertificate {
  productId     Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([productId, certificateId])
  @@index([certificateId])
}

// "Report this product" (DSA Art. 16 notice, GPSR Art. 22(8): product-safety notices handled within 3 working days).
// Works signed in or not; reporterEmail is an optional contact for the outcome. Personal data: removed with the account.
model ProductReport {
  id             Int          @id @default(autoincrement())
  productId      Int
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporterId     Int?
  reporterEmail  String?
  reason         String // unsafe | counterfeit | illegal | misleading | other
  details        String?
  status         ReportStatus @default(OPEN)
  resolution     String? // "dismissed" | "listing_removed"
  resolutionNote String?
  resolvedById   Int?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([productId])
  @@index([reporterId])
}

enum RecallStatus {
  ACTIVE
  CLOSED
}

// Product safety recall (GPSR Art. 22(12), 35-37): every identical listing is locked and every buyer is told directly.
model Recall {
  id               Int                  @id @default(autoincrement())
  title            String
  reasonFi         String // the hazard, without softening words
  reasonEn         String
  reasonSv         String?
  remedyFi         String // what to do and how the remedy works
  remedyEn         String
  remedySv         String?
  remedies         String[] // repair | replacement | refund
  contact          String // free phone number or online service
  status           RecallStatus         @default(ACTIVE)
  createdById      Int
  closedAt         DateTime?
  buyersNotifiedAt DateTime?
  notifiedUsers    Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  products         RecallProduct[]
  notifications    RecallNotification[]

  @@index([status, createdAt])
}

model RecallProduct {
  recallId  Int
  recall    Recall  @relation(fields: [recallId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  matchedBy String // "selected" | "gtin" | "brand_model"

  @@id([recallId, productId])
  @@index([productId])
}

// One direct recall notice to a buyer per channel (a legal obligation: sent even when marketing is switched off).
model RecallNotification {
  id        Int      @id @default(autoincrement())
  recallId  Int
  recall    Recall   @relation(fields: [recallId], references: [id], onDelete: Cascade)
  userId    Int
  channel   String // "push" | "email"
  delivered Boolean
  locale    String
  sentAt    DateTime @default(now())

  @@unique([recallId, userId, channel])
  @@index([userId])
}

// ─────────────────────────────────────────────
// LIVE SHOPPING (since 2.15.0)
// ─────────────────────────────────────────────

enum LiveStatus {
  LIVE
  ENDED
}

// A store's live video (LiveKit WebRTC room; nothing is recorded). The store shows 1–10 of its own products.
model LiveStream {
  id                Int        @id @default(autoincrement())
  storeId           Int
  store             Store      @relation(fields: [storeId], references: [id])
  title             String
  productIds        Int[] // the featured products, in the store's order
  pinnedProductId   Int?
  roomName          String     @unique // LiveKit room: live-<id>-<random>
  status            LiveStatus @default(LIVE)
  startedAt         DateTime   @default(now())
  endedAt           DateTime?
  lastHeartbeatAt   DateTime   @default(now())
  viewers           Int        @default(0) // signed-in viewers connected now (sockets in live:<id>), updated at most every 5 s
  viewerPeak        Int        @default(0)
  likeCount         Int        @default(0)
  // "store" | "timeout" | "max_duration" | the admin's reason (statement of reasons, emailed to the store)
  endedReason       String?
  endedById         Int? // the admin who ended it
  followersNotified Int? // followers pushed "<store> is live" (null = none: the store was announced in the last 6 h)
  createdAt         DateTime   @default(now())

  messages LiveMessage[]
  bans     LiveBan[]
  reports  LiveReport[]

  @@index([status, startedAt])
  @@index([status, lastHeartbeatAt])
  @@index([status, endedAt])
  @@index([storeId, createdAt])
}

// Live chat: kept 30 days after the live ended (scheduler live-chat-purge); deleted with the account
model LiveMessage {
  id          Int        @id @default(autoincrement())
  liveId      Int
  live        LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  hidden      Boolean    @default(false) // hidden by the store, an admin or three reports
  // Who hid it (2.16): "store" | "admin" | "reports"; reports from viewers and when an admin looked at them
  hiddenBy    String?
  reportCount Int        @default(0)
  reviewedAt  DateTime? // an admin decided on the reports
  createdAt   DateTime   @default(now())

  reports LiveMessageReport[]

  @@index([liveId, id])
  @@index([userId, createdAt])
  @@index([reportCount, reviewedAt])
}

// A viewer reported a live chat message (DSA Art. 16, since 2.16.0); three distinct reporters hide it until an admin decides
model LiveMessageReport {
  messageId  Int
  message    LiveMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime    @default(now())

  @@id([messageId, reporterId])
  @@index([reporterId])
}

// The store (or an admin) muted this viewer in this live: their chat is refused
model LiveBan {
  id         Int        @id @default(autoincrement())
  liveId     Int
  live       LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannedById Int
  createdAt  DateTime   @default(now())

  @@unique([liveId, userId])
  @@index([userId])
}

// Notice-and-action on a live (DSA Art. 16), reasons as drop reports; decided by an admin
model LiveReport {
  id           Int          @id @default(autoincrement())
  liveId       Int
  live         LiveStream   @relation(fields: [liveId], references: [id], onDelete: Cascade)
  reporterId   Int?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([liveId, status])
  @@index([status, createdAt])
  @@index([reporterId])
}

// ─────────────────────────────────────────────
// COURIER SAFETY (since 2.16.0)
// ─────────────────────────────────────────────

enum IncidentType {
  ACCIDENT
  THREAT
  DAMAGED
  THEFT
  OTHER
}

// A courier asked for help or reported something that happened on a job. Admins are pushed and emailed at once; it
// stays in System → attention until an admin resolves it.
model CourierIncident {
  id             Int          @id @default(autoincrement())
  courierId      Int
  courier        Courier      @relation(fields: [courierId], references: [id])
  type           IncidentType
  orderId        Int?
  note           String?
  latitude       Float?
  longitude      Float?
  status         String       @default("OPEN") // OPEN | RESOLVED
  resolutionNote String?
  resolvedById   Int?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([courierId, createdAt])
}
